# ==============================================================================
# RelayOps Configuration (.env.example)
#
# Copy this file to `.env` in the repository root or configure in your deployment platform.
# The application runs with zero external API keys out of the box in replay mode!
# ==============================================================================

# --- Core Runtime -------------------------------------------------------------
# Options: dev | prod (or development | production)
# In production (ENV=prod), SECRET_KEY must be a random string >= 32 characters or the app fails fast on start.
ENV=dev
LOG_LEVEL=INFO

# Database connection URL.
# Local development: sqlite:///./data/relayops.db (anchored to backend/)
# Docker / Cloud container: sqlite:////app/data/relayops.db (mapped to persistent volume)
DATABASE_URL=sqlite:///./data/relayops.db

# Cryptographic signing secret for JWT access tokens and audit hash chains.
# Generate a production key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me

# --- LLM Engine & Zero-Key Replay Mode ----------------------------------------
# Provider: replay | anthropic | openai
# When set to 'replay' (or when API keys are blank), RelayOps uses recorded model outputs from seed data.
LLM_PROVIDER=replay
LLM_MODEL=claude-sonnet-4-5
LLM_TIMEOUT_SECONDS=60
LLM_TOKEN_BUDGET_PER_JOB=100000

# Optional live provider keys (leave empty for replay mode):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Source Ingestion ---------------------------------------------------------
# Optional GitHub Personal Access Token to avoid rate limits during real repository syncs:
GITHUB_TOKEN=

# --- Web & API Server ---------------------------------------------------------
# Comma-separated list of allowed CORS origins:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
MAX_UPLOAD_MB=20
PORT=8000

# --- Demo & Initial Seed ------------------------------------------------------
# Automatically seed the PayFlow demo dataset & demo accounts on startup IF the database is empty:
SEED_ON_START=true
