# Copy to .env (never commit .env). The app runs with no keys at all: LLM_PROVIDER=replay
# serves recorded model output, so the full demo works offline.

# --- Core -------------------------------------------------------------------
ENV=dev
LOG_LEVEL=INFO
# SQLite by default. Relative paths are anchored to backend/.
DATABASE_URL=sqlite:///./data/relayops.db
# Replace before any public deployment (must be >= 32 chars when ENV=prod).
SECRET_KEY=dev-only-insecure-secret-change-me

# --- LLM --------------------------------------------------------------------
# anthropic | openai | replay. Any provider without its key falls back to replay.
LLM_PROVIDER=replay
LLM_MODEL=claude-sonnet-4-5
LLM_TIMEOUT_SECONDS=60
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Ingestion --------------------------------------------------------------
# Optional: raises GitHub's rate limit when syncing a real repository.
GITHUB_TOKEN=

# --- Web --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=20

# --- Demo -------------------------------------------------------------------
# Seed demo users and the PayFlow dataset on first start when the DB is empty.
SEED_ON_START=true
