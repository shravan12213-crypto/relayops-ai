{
  "name": "relayops",
  "version": "0.1.0",
  "private": true,
  "description": "RelayOps — traceable, human-verified handovers from scattered project activity.",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "bash scripts/dev.sh",
    "test": "bash scripts/test.sh",
    "build": "bash scripts/build.sh",
    "seed": "bash scripts/seed.sh",
    "eval": "bash scripts/eval.sh",
    "typecheck": "npm --prefix frontend run typecheck",
    "test:frontend": "npm --prefix frontend run test",
    "test:e2e": "playwright test",
    "lint": "npm --prefix frontend run lint && bash scripts/lint-backend.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0"
  }
}
